# ==========================================
# CampusVerse Full-Stack Environment Configuration
# ==========================================

# Server Environment & Port (Koyeb/Render/Back4App automatically injects PORT)
ENVIRONMENT=production
PORT=8000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Database Connection (MongoDB Atlas URI or leave empty for standalone mode)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusverse?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/campusverse
DB_NAME=campusverse

# Authentication (JWT Secret Key - 32+ characters)
JWT_SECRET=campusverse_super_secret_jwt_key_at_least_32_chars_long_2026
JWT_EXPIRES_DAYS=7

# File Storage Provider ("local" | "supabase" | "cloudinary")
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Optional: Google Gemini AI Key (If blank, intelligent built-in semantic engine is used)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend API Base URL (leave as /api for full-stack container deployment)
VITE_API_BASE_URL=/api
VITE_API_URL=/api
