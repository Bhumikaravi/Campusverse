# ============================================================
# CampusVerse — Supabase Edge Functions Configuration
# ============================================================
# Configure these variables in Supabase Dashboard:
# Project Settings > Edge Functions > Secrets
#
# DO NOT commit secrets to GitHub.
# ============================================================

# Supabase Project Configuration
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret-key>
SUPABASE_ANON_KEY=<your-anon-public-key>
SUPABASE_BUCKET=study-materials

# AI Provider: Google Gemini
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-1.5-flash

# Academic Safety & Review Thresholds
AUTO_PUBLISH_AI_APPROVED=true
AUTO_PUBLISH_MIN_CONFIDENCE=0.90
MAX_DOCUMENT_PAGES=150
MAX_SUMMARY_WORDS=500
