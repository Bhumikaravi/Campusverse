# ==========================================
# CampusVerse FastAPI Backend Configuration
# ==========================================

# Server Environment
ENVIRONMENT=development
PORT=5000
# Comma-separated frontend origins for CORS and frame-ancestors
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Connection String (Atlas Free Tier or Local MongoDB)
# For Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusverse?retryWrites=true&w=majority
# For Local: mongodb://localhost:27017/campusverse
MONGODB_URI=mongodb://localhost:27017/campusverse
DB_NAME=campusverse

# Authentication (JWT)
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_32_char_jwt_secret_key_here_generate_with_python
JWT_EXPIRES_DAYS=7

# File Storage Provider: "local" | "supabase" | "cloudinary"
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Supabase Storage Configuration (Required if STORAGE_PROVIDER=supabase)
# 1. Project URL from Supabase dashboard (Project Settings > API)
SUPABASE_URL=
# 2. Service Role Secret Key (Never expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY=
# 3. Bucket Name (Created in Supabase Storage with Private visibility)
SUPABASE_BUCKET=study-materials

# Cloudinary Storage Configuration (Required if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Moderation (Google Gemini Free Tier)
# Get a free key at: https://aistudio.google.com/app/apikey
# If left empty, the system automatically uses the intelligent rule-based fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Moderation Publication Policy
# When false: all materials require human moderator approval before public visibility (Recommended)
# When true: high-confidence AI-approved materials are automatically visible
AUTO_PUBLISH_AI_APPROVED=false
AUTO_PUBLISH_MIN_CONFIDENCE=0.90
